# Copy to /opt/shine/.env on the EC2 host (never commit real secrets).

DOMAIN=shine.duckdns.org
# Subdomain label only, not the full hostname.
DUCKDNS_SUBDOMAIN=shine
DUCKDNS_TOKEN=replace-with-duckdns-token

IMAGE=ghcr.io/lisss/shine:latest

# Canonical public URL (sitemap, Open Graph, role pages) — keep in sync with DOMAIN
PUBLIC_SITE_URL=https://shine.duckdns.org

# Optional: Search Console HTML-tag method (meta content=…)
# HTML-file method works automatically via /googleXXXX.html after deploy.
GOOGLE_SITE_VERIFICATION=

REMOTIVE_ENABLED=true
YOUTUBE_API_KEY=
GOOGLE_BOOKS_API_KEY=
GITHUB_TOKEN=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
