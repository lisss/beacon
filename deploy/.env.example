# Copy to /opt/jobby/.env on the EC2 host (never commit real secrets).

# Free DuckDNS hostname, e.g. jobby.duckdns.org
DOMAIN=jobby.duckdns.org
# Just the subdomain label (jobby), not the full hostname
DUCKDNS_SUBDOMAIN=jobby
DUCKDNS_TOKEN=replace-with-duckdns-token

# GHCR image published by GitHub Actions
IMAGE=ghcr.io/lisss/jobby:latest

# Canonical public URL (sitemap, Open Graph, role pages)
PUBLIC_SITE_URL=https://jobby.duckdns.org

# Optional: Search Console HTML-tag method (meta content=…)
# HTML-file method works automatically via /googleXXXX.html after deploy.
GOOGLE_SITE_VERIFICATION=

# Optional API keys (same as local .env)
REMOTIVE_ENABLED=true
YOUTUBE_API_KEY=
GOOGLE_BOOKS_API_KEY=
GITHUB_TOKEN=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
