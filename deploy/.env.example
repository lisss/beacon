# Copy to /opt/jobify/.env on the EC2 host (never commit real secrets).

# Free DuckDNS hostname, e.g. jobify.duckdns.org
DOMAIN=jobify.duckdns.org
# Just the subdomain label (jobify), not the full hostname
DUCKDNS_SUBDOMAIN=jobify
DUCKDNS_TOKEN=replace-with-duckdns-token

# GHCR image published by GitHub Actions
IMAGE=ghcr.io/lisss/jobify:latest

# Canonical public URL (sitemap, Open Graph, role pages)
PUBLIC_SITE_URL=https://jobify.duckdns.org

# Optional: Search Console HTML-tag method (meta content=…)
# HTML-file method works automatically via /googleXXXX.html after deploy.
GOOGLE_SITE_VERIFICATION=

# Optional API keys (same as local .env)
REMOTIVE_ENABLED=true
YOUTUBE_API_KEY=
GOOGLE_BOOKS_API_KEY=
GITHUB_TOKEN=
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
