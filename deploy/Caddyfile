# Canonical hostname (SEO). Set DOMAIN in .env, e.g. getcasty.duckdns.org
{$DOMAIN} {
	encode gzip
	reverse_proxy api:8000
}

# Previous DuckDNS names → canonical (SEO)
pathjobify.duckdns.org {
	redir https://{$DOMAIN}{uri} permanent
}

pathjobby.duckdns.org {
	redir https://{$DOMAIN}{uri} permanent
}
